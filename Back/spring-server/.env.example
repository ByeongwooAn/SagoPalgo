# 로컬 MySQL 연결 주소입니다.
# schema.sql을 실행한 데이터베이스 이름이 sagopalgo라면 기본값을 그대로 사용할 수 있습니다.
SAGOPALGO_SERVER_PORT=8080
SAGOPALGO_DB_URL=jdbc:mysql://localhost:3306/sagopalgo?serverTimezone=UTC&characterEncoding=UTF-8

# 로컬 MySQL 사용자 이름입니다.
SAGOPALGO_DB_USERNAME=root

# 로컬 MySQL 비밀번호입니다.
SAGOPALGO_DB_PASSWORD=change-me

# 개인용 Windows 프로그램 모드입니다.
SAGOPALGO_PERSONAL_MODE_ENABLED=true
SAGOPALGO_PERSONAL_MODE_USER_ID=1
SAGOPALGO_PERSONAL_MODE_NICKNAME=개인 사용자
SAGOPALGO_PERSONAL_MODE_EMAIL=local@sagopalgo.local

# KB증권은 계좌 조회와 추후 주문 기능의 기준 증권사입니다.
# 공개 API path와 기본 요청값은 백엔드 기본 설정을 사용합니다.
SAGOPALGO_KB_MARKET_DATA_ENABLED=false
SAGOPALGO_KB_ACCOUNT_ENABLED=false
SAGOPALGO_KB_ORDER_ENABLED=false
SAGOPALGO_KB_APP_KEY=
SAGOPALGO_KB_APP_SECRET=
SAGOPALGO_KB_ACCOUNT_NUMBER=

# 토스증권은 분석용 시세/종목 정보 보조 소스로 둡니다.
SAGOPALGO_TOSS_MARKET_DATA_ENABLED=false
SAGOPALGO_TOSS_BASE_URL=
SAGOPALGO_TOSS_CURRENT_PRICE_PATH=
SAGOPALGO_TOSS_APP_KEY=
SAGOPALGO_TOSS_APP_SECRET=

# 한국투자증권 Open API 시세 설정입니다.
# 실제 현재가를 확인할 때만 enabled를 true로 바꾸고 App Key/Secret을 입력합니다.
SAGOPALGO_KIS_ENABLED=false
SAGOPALGO_KIS_BASE_URL=https://openapi.koreainvestment.com:9443
SAGOPALGO_KIS_APP_KEY=your-kis-app-key
SAGOPALGO_KIS_APP_SECRET=your-kis-app-secret
SAGOPALGO_KIS_GRANT_TYPE=client_credentials
SAGOPALGO_KIS_TOKEN_PATH=/oauth2/tokenP
SAGOPALGO_KIS_PRICE_PATH=/uapi/domestic-stock/v1/quotations/inquire-price
SAGOPALGO_KIS_PRICE_TR_ID=FHKST01010100
SAGOPALGO_KIS_CUSTOMER_TYPE=P

# 네이버 뉴스 검색 API 설정입니다. Client ID/Secret은 검색 API 권한이 있는 앱에서 발급받습니다.
SAGOPALGO_NAVER_NEWS_ENABLED=false
SAGOPALGO_NAVER_NEWS_CLIENT_ID=
SAGOPALGO_NAVER_NEWS_CLIENT_SECRET=
SAGOPALGO_NAVER_NEWS_DISPLAY=10

# OpenDART 공시 API 설정입니다. 종목코드는 고유번호 파일을 통해 자동으로 연결합니다.
SAGOPALGO_OPEN_DART_ENABLED=false
SAGOPALGO_OPEN_DART_API_KEY=
SAGOPALGO_OPEN_DART_LOOKBACK_DAYS=30
SAGOPALGO_OPEN_DART_PAGE_COUNT=20

# 관심 종목 뉴스·공시 자동 동기화 설정입니다.
SAGOPALGO_RESEARCH_SYNC_ENABLED=false
SAGOPALGO_RESEARCH_SYNC_CRON=0 0/30 * * * *
SAGOPALGO_RESEARCH_SYNC_ZONE=Asia/Seoul
