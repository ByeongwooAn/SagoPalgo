# 로컬 MySQL 연결 주소입니다.
# schema.sql을 실행한 데이터베이스 이름이 sagopalgo라면 기본값을 그대로 사용할 수 있습니다.
SAGOPALGO_SERVER_PORT=8080
SAGOPALGO_DB_URL=jdbc:mysql://localhost:3306/sagopalgo?serverTimezone=UTC&characterEncoding=UTF-8

# 로컬 MySQL 사용자 이름입니다.
SAGOPALGO_DB_USERNAME=root

# 로컬 MySQL 비밀번호입니다.
SAGOPALGO_DB_PASSWORD=change-me

# 개인용 Windows 프로그램 모드입니다.
SAGOPALGO_PERSONAL_MODE_ENABLED=true
SAGOPALGO_PERSONAL_MODE_USER_ID=1
SAGOPALGO_PERSONAL_MODE_NICKNAME=개인 사용자
SAGOPALGO_PERSONAL_MODE_EMAIL=local@sagopalgo.local

# 과거 JWT 인증 API 호환용 설정입니다. 개인용 모드에서는 직접 로그인에 사용하지 않습니다.
SAGOPALGO_JWT_SECRET=replace-with-long-random-secret-key-at-least-32-bytes

# access token 만료 시간입니다.
SAGOPALGO_ACCESS_TOKEN_MINUTES=60

# refresh token 만료 일수입니다.
SAGOPALGO_REFRESH_TOKEN_DAYS=14

# 과거 Google/Naver 소셜 로그인 API 호환용 설정입니다. 개인용 모드에서는 비워둘 수 있습니다.
SAGOPALGO_GOOGLE_CLIENT_ID=
SAGOPALGO_GOOGLE_JWKS_URI=https://www.googleapis.com/oauth2/v3/certs

SAGOPALGO_NAVER_CLIENT_ID=
SAGOPALGO_NAVER_CLIENT_SECRET=
SAGOPALGO_NAVER_REDIRECT_URI=sagopalgo://oauth/naver
SAGOPALGO_NAVER_AUTHORIZE_URI=https://nid.naver.com/oauth2.0/authorize
SAGOPALGO_NAVER_TOKEN_URI=https://nid.naver.com/oauth2.0/token
SAGOPALGO_NAVER_PROFILE_URI=https://openapi.naver.com/v1/nid/me

# 한국투자증권 Open API 시세 설정입니다.
# 실제 현재가를 확인할 때만 enabled를 true로 바꾸고 App Key/Secret을 입력합니다.
SAGOPALGO_KIS_ENABLED=false
SAGOPALGO_KIS_BASE_URL=https://openapi.koreainvestment.com:9443
SAGOPALGO_KIS_APP_KEY=your-kis-app-key
SAGOPALGO_KIS_APP_SECRET=your-kis-app-secret
SAGOPALGO_KIS_GRANT_TYPE=client_credentials
SAGOPALGO_KIS_TOKEN_PATH=/oauth2/tokenP
SAGOPALGO_KIS_PRICE_PATH=/uapi/domestic-stock/v1/quotations/inquire-price
SAGOPALGO_KIS_PRICE_TR_ID=FHKST01010100
SAGOPALGO_KIS_CUSTOMER_TYPE=P
