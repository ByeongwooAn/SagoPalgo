# 개인 PC 고정 실행 Docker Compose 설정입니다.
# 실제 실행할 때는 이 파일을 .env.prod로 복사한 뒤 내 PC의 비밀값으로 교체합니다.
SAGOPALGO_TIMEZONE=Asia/Seoul

# DB는 Docker 내부 네트워크에서만 사용하므로 호스트 포트 값은 사용하지 않습니다.
SAGOPALGO_MYSQL_DATABASE=sagopalgo
SAGOPALGO_MYSQL_ROOT_PASSWORD=replace-with-strong-local-db-password

# 로컬 Nginx 프록시만 엽니다.
SAGOPALGO_PROXY_HTTP_PORT=8081
SAGOPALGO_NGINX_SERVER_NAME=localhost

# 개인용 Windows 프로그램 모드입니다.
SAGOPALGO_PERSONAL_MODE_ENABLED=true
SAGOPALGO_PERSONAL_MODE_USER_ID=1
SAGOPALGO_PERSONAL_MODE_NICKNAME=개인 사용자
SAGOPALGO_PERSONAL_MODE_EMAIL=local@sagopalgo.local
SAGOPALGO_APP_LOCK_PIN=

# KB증권은 계좌 조회와 추후 주문 기능의 기준 증권사입니다.
# 공개 API path와 기본 요청값은 백엔드 기본 설정을 사용합니다.
SAGOPALGO_KB_MARKET_DATA_ENABLED=false
SAGOPALGO_KB_ACCOUNT_ENABLED=false
SAGOPALGO_KB_ORDER_ENABLED=false
SAGOPALGO_KB_APP_KEY=
SAGOPALGO_KB_APP_SECRET=
SAGOPALGO_KB_ACCOUNT_NUMBER=

# 토스증권은 분석용 시세/종목 정보 보조 소스로 둡니다.
SAGOPALGO_TOSS_MARKET_DATA_ENABLED=false
SAGOPALGO_TOSS_APP_KEY=
SAGOPALGO_TOSS_APP_SECRET=

# 한국투자증권 Open API 시세 설정입니다.
# App Key/Secret은 내 PC의 .env에서만 관리하고 저장소에 커밋하지 않습니다.
SAGOPALGO_KIS_ENABLED=true
SAGOPALGO_KIS_BASE_URL=https://openapi.koreainvestment.com:9443
SAGOPALGO_KIS_APP_KEY=your-prod-kis-app-key
SAGOPALGO_KIS_APP_SECRET=your-prod-kis-app-secret
SAGOPALGO_KIS_GRANT_TYPE=client_credentials
SAGOPALGO_KIS_TOKEN_PATH=/oauth2/tokenP
SAGOPALGO_KIS_PRICE_PATH=/uapi/domestic-stock/v1/quotations/inquire-price
SAGOPALGO_KIS_PRICE_TR_ID=FHKST01010100
SAGOPALGO_KIS_CUSTOMER_TYPE=P
