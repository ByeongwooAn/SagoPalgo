# Docker Compose 공통 예시 설정입니다.
# 실제 개발/운영 실행은 .env.dev.example 또는 .env.prod.example을 복사해서 사용하는 방식을 권장합니다.
SAGOPALGO_TIMEZONE=Asia/Seoul

# 개발 환경에서 호스트 PC가 MySQL에 접근할 포트입니다.
SAGOPALGO_MYSQL_PORT=3306
SAGOPALGO_MYSQL_DATABASE=sagopalgo
SAGOPALGO_MYSQL_ROOT_PASSWORD=change-me-root-password

# 개발 환경에서 호스트 PC가 Spring Boot API에 접근할 포트입니다.
SAGOPALGO_API_PORT=8080
SAGOPALGO_AI_PORT=8000

# 로컬 Nginx 리버스 프록시 설정입니다.
SAGOPALGO_NGINX_SERVER_NAME=localhost
SAGOPALGO_ALLOWED_CLIENT_IP=127.0.0.1
SAGOPALGO_PROXY_HTTP_PORT=8081

# 개인용 Windows 프로그램 모드입니다.
SAGOPALGO_PERSONAL_MODE_ENABLED=true
SAGOPALGO_PERSONAL_MODE_USER_ID=1
SAGOPALGO_PERSONAL_MODE_NICKNAME=개인 사용자
SAGOPALGO_PERSONAL_MODE_EMAIL=local@sagopalgo.local
SAGOPALGO_APP_LOCK_PIN=

# 로컬 Python 분석 서버와 분석 범위입니다.
SAGOPALGO_AI_ENABLED=true
SAGOPALGO_AI_ANALYSIS_PATH=/internal/ai/analyze-investment
SAGOPALGO_AI_LOOKBACK_DAYS=30
SAGOPALGO_AI_CANDLE_COUNT=30

# 보유 종목 자동 분석과 알림 중복 방지 설정입니다.
SAGOPALGO_ALERT_ANALYSIS_ENABLED=false
SAGOPALGO_ALERT_ANALYSIS_CRON=0 0/15 * * * *
SAGOPALGO_ALERT_ANALYSIS_ZONE=Asia/Seoul
SAGOPALGO_ALERT_COOLDOWN_MINUTES=60
SAGOPALGO_ALERT_PRICE_EVENTS_ENABLED=true
SAGOPALGO_ALERT_VOLATILITY_THRESHOLD_RATE=5.0
SAGOPALGO_ALERT_RESEARCH_EVENTS_ENABLED=true
SAGOPALGO_ALERT_NEWS_MAX_AGE_HOURS=24
SAGOPALGO_ALERT_DISCLOSURE_MAX_AGE_DAYS=1
SAGOPALGO_ALERT_PORTFOLIO_EVENTS_ENABLED=true

# KB증권은 계좌 조회와 추후 주문 기능의 기준 증권사입니다.
# 공개 API path와 기본 요청값은 백엔드 기본 설정을 사용합니다.
SAGOPALGO_KB_MARKET_DATA_ENABLED=false
SAGOPALGO_KB_ACCOUNT_ENABLED=false
SAGOPALGO_KB_ORDER_ENABLED=false
SAGOPALGO_KB_APP_KEY=
SAGOPALGO_KB_APP_SECRET=
SAGOPALGO_KB_ACCOUNT_NUMBER=

# 토스증권은 분석용 시세/종목 정보 보조 소스로 둡니다.
SAGOPALGO_TOSS_MARKET_DATA_ENABLED=false
SAGOPALGO_TOSS_BASE_URL=https://openapi.tossinvest.com
SAGOPALGO_TOSS_GRANT_TYPE=client_credentials
SAGOPALGO_TOSS_TOKEN_PATH=/oauth2/token
SAGOPALGO_TOSS_CURRENT_PRICE_PATH=/api/v1/prices
SAGOPALGO_TOSS_STOCK_INFO_PATH=/api/v1/stocks
SAGOPALGO_TOSS_CANDLE_PATH=/api/v1/candles
SAGOPALGO_TOSS_APP_KEY=
SAGOPALGO_TOSS_APP_SECRET=

# 한국투자증권 Open API 시세 설정입니다.
# 실제 현재가를 확인할 때만 enabled를 true로 바꾸고 App Key/Secret을 입력합니다.
SAGOPALGO_KIS_ENABLED=false
SAGOPALGO_KIS_BASE_URL=https://openapi.koreainvestment.com:9443
SAGOPALGO_KIS_APP_KEY=your-kis-app-key
SAGOPALGO_KIS_APP_SECRET=your-kis-app-secret
SAGOPALGO_KIS_GRANT_TYPE=client_credentials
SAGOPALGO_KIS_TOKEN_PATH=/oauth2/tokenP
SAGOPALGO_KIS_PRICE_PATH=/uapi/domestic-stock/v1/quotations/inquire-price
SAGOPALGO_KIS_PRICE_TR_ID=FHKST01010100
SAGOPALGO_KIS_CANDLE_PATH=/uapi/domestic-stock/v1/quotations/inquire-daily-itemchartprice
SAGOPALGO_KIS_CANDLE_TR_ID=FHKST03010100
SAGOPALGO_KIS_CUSTOMER_TYPE=P

# 네이버 뉴스 검색 API입니다.
SAGOPALGO_NAVER_NEWS_ENABLED=false
SAGOPALGO_NAVER_NEWS_CLIENT_ID=
SAGOPALGO_NAVER_NEWS_CLIENT_SECRET=
SAGOPALGO_NAVER_NEWS_DISPLAY=10

# OpenDART 공시검색 API입니다.
SAGOPALGO_OPEN_DART_ENABLED=false
SAGOPALGO_OPEN_DART_API_KEY=
SAGOPALGO_OPEN_DART_LOOKBACK_DAYS=30
SAGOPALGO_OPEN_DART_PAGE_COUNT=20
