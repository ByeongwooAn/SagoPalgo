# Docker Compose 공통 예시 설정입니다.
# 실제 개발/운영 실행은 .env.dev.example 또는 .env.prod.example을 복사해서 사용하는 방식을 권장합니다.
SAGOPALGO_TIMEZONE=Asia/Seoul

# 개발 환경에서 호스트 PC가 MySQL에 접근할 포트입니다.
SAGOPALGO_MYSQL_PORT=3306
SAGOPALGO_MYSQL_DATABASE=sagopalgo
SAGOPALGO_MYSQL_ROOT_PASSWORD=change-me-root-password

# 개발 환경에서 호스트 PC와 Android 에뮬레이터가 Spring Boot API에 접근할 포트입니다.
SAGOPALGO_API_PORT=8080

# Nginx 리버스 프록시 설정입니다.
SAGOPALGO_NGINX_SERVER_NAME=api.sagopalgo.app
SAGOPALGO_PROXY_HTTP_PORT=8081
SAGOPALGO_PROXY_HTTPS_PORT=443

# 운영 HTTPS 인증서 설정입니다.
# 운영 override를 사용할 때 서버 로컬 인증서 디렉터리를 /etc/nginx/certs로 마운트합니다.
SAGOPALGO_NGINX_CERTS_DIR=/etc/letsencrypt/live/api.sagopalgo.app
SAGOPALGO_NGINX_SSL_CERTIFICATE_PATH=/etc/nginx/certs/fullchain.pem
SAGOPALGO_NGINX_SSL_CERTIFICATE_KEY_PATH=/etc/nginx/certs/privkey.pem

# Spring Boot JWT 설정입니다.
SAGOPALGO_JWT_SECRET=replace-with-long-random-secret-key-at-least-32-bytes
SAGOPALGO_ACCESS_TOKEN_MINUTES=60
SAGOPALGO_REFRESH_TOKEN_DAYS=14

# Google/Naver 소셜 로그인 설정입니다.
SAGOPALGO_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
SAGOPALGO_GOOGLE_JWKS_URI=https://www.googleapis.com/oauth2/v3/certs
SAGOPALGO_NAVER_CLIENT_ID=your-naver-client-id
SAGOPALGO_NAVER_CLIENT_SECRET=your-naver-client-secret
SAGOPALGO_NAVER_REDIRECT_URI=sagopalgo://oauth/naver
SAGOPALGO_NAVER_AUTHORIZE_URI=https://nid.naver.com/oauth2.0/authorize
SAGOPALGO_NAVER_TOKEN_URI=https://nid.naver.com/oauth2.0/token
SAGOPALGO_NAVER_PROFILE_URI=https://openapi.naver.com/v1/nid/me

# 한국투자증권 Open API 시세 설정입니다.
# 실제 현재가를 확인할 때만 enabled를 true로 바꾸고 App Key/Secret을 입력합니다.
SAGOPALGO_KIS_ENABLED=false
SAGOPALGO_KIS_BASE_URL=https://openapi.koreainvestment.com:9443
SAGOPALGO_KIS_APP_KEY=your-kis-app-key
SAGOPALGO_KIS_APP_SECRET=your-kis-app-secret
SAGOPALGO_KIS_GRANT_TYPE=client_credentials
SAGOPALGO_KIS_TOKEN_PATH=/oauth2/tokenP
SAGOPALGO_KIS_PRICE_PATH=/uapi/domestic-stock/v1/quotations/inquire-price
SAGOPALGO_KIS_PRICE_TR_ID=FHKST01010100
SAGOPALGO_KIS_CUSTOMER_TYPE=P
