# 운영 배포에서 Flutter 앱이 호출할 사고팔고 API 주소입니다.
# 로컬 Android 에뮬레이터에서는 http://10.0.2.2:8080 또는 http://10.0.2.2:8081 로 바꿔 테스트합니다.
SAGOPALGO_API_BASE_URL=https://api.sagopalgo.app

# 실제 Google/Naver SDK 연결 전까지는 true로 두어 Mock 로그인 UI 흐름을 확인합니다.
SAGOPALGO_USE_MOCK_AUTH=true

# Google 공식 google_sign_in 초기화에 사용할 공개 server client id입니다.
SAGOPALGO_GOOGLE_SERVER_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Naver Android SDK 초기화에 사용할 공개 client id입니다.
# Naver client secret은 백엔드 .env에서만 관리합니다.
SAGOPALGO_NAVER_CLIENT_ID=your-naver-client-id
