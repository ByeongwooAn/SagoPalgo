# Flutter 앱이 호출할 사고팔고 API 주소입니다.
# 실제 Android 기기에서 Ubuntu 개발 서버에 붙을 때는 http://192.168.0.25:8081 처럼 Nginx 포트를 권장합니다.
# 이 값을 비워두면 SAGOPALGO_NGINX_SERVER_NAME + SAGOPALGO_PROXY_HTTP_PORT 조합으로 자동 계산합니다.
SAGOPALGO_API_BASE_URL=https://api.sagopalgo.app

# 루트 .env.dev를 앱 .env로 복사해서 쓰는 경우 아래 Docker 개발 키로 API 주소를 계산할 수 있습니다.
SAGOPALGO_API_PORT=8080
SAGOPALGO_PROXY_HTTP_PORT=8081
SAGOPALGO_NGINX_SERVER_NAME=192.168.0.25

# Google 공식 google_sign_in 초기화에 사용할 공개 server client id입니다.
# 루트 .env.dev의 SAGOPALGO_GOOGLE_CLIENT_ID도 같은 값으로 인식합니다.
SAGOPALGO_GOOGLE_SERVER_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Naver Client ID/Secret/Redirect URI는 백엔드 .env.dev/.env.prod에만 둡니다.
