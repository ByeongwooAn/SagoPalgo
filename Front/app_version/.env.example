# Flutter Windows 앱이 호출할 사고팔고 API 주소입니다.
# Ubuntu 백엔드를 사용할 때는 http://ubuntu-server.local:8081 또는 서버 고정 IP를 입력합니다.
# 이 값을 비워두면 SAGOPALGO_NGINX_SERVER_NAME + SAGOPALGO_PROXY_HTTP_PORT 조합으로 자동 계산합니다.
SAGOPALGO_API_BASE_URL=http://ubuntu-server.local:8081

# 루트 .env.dev를 앱 .env로 복사해서 쓰는 경우 아래 Docker 개발 키로 API 주소를 계산할 수 있습니다.
SAGOPALGO_API_PORT=8080
SAGOPALGO_PROXY_HTTP_PORT=8081
SAGOPALGO_NGINX_SERVER_NAME=localhost

# 기존 설치의 1회 이전용 앱 잠금 PIN입니다.
# 앱을 한 번 실행해 Windows Credential Manager로 이전한 뒤 이 값은 비우세요.
# 새 PIN은 앱의 설정 > Windows 앱 잠금에서 등록합니다.
SAGOPALGO_APP_LOCK_PIN=
