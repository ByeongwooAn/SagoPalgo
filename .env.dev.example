# 개발 환경 Docker Compose 설정입니다.
# 실제 실행할 때는 이 파일을 .env.dev로 복사한 뒤 필요한 값만 수정합니다.
SAGOPALGO_TIMEZONE=Asia/Seoul

# 개발 중에는 로컬 DB 클라이언트에서 접속할 수 있도록 MySQL 포트를 엽니다.
SAGOPALGO_MYSQL_PORT=3306
SAGOPALGO_MYSQL_DATABASE=sagopalgo_dev
SAGOPALGO_MYSQL_ROOT_PASSWORD=change-me-dev-root-password

# 개발 중에는 Spring API 직접 접근과 Nginx 경유 접근을 둘 다 열어둡니다.
SAGOPALGO_API_PORT=8080
SAGOPALGO_PROXY_HTTP_PORT=8081
SAGOPALGO_NGINX_SERVER_NAME=localhost

# 개발용 JWT 값입니다. 실제 운영 값과 절대 공유하지 않습니다.
SAGOPALGO_JWT_SECRET=replace-with-long-random-dev-secret-key-at-least-32-bytes
SAGOPALGO_ACCESS_TOKEN_MINUTES=60
SAGOPALGO_REFRESH_TOKEN_DAYS=14

# 개발용 Google/Naver 소셜 로그인 앱 설정입니다.
SAGOPALGO_GOOGLE_CLIENT_ID=your-dev-google-oauth-client-id.apps.googleusercontent.com
SAGOPALGO_GOOGLE_JWKS_URI=https://www.googleapis.com/oauth2/v3/certs
SAGOPALGO_NAVER_CLIENT_ID=your-dev-naver-client-id
SAGOPALGO_NAVER_CLIENT_SECRET=your-dev-naver-client-secret
SAGOPALGO_NAVER_REDIRECT_URI=sagopalgo://oauth/naver
SAGOPALGO_NAVER_AUTHORIZE_URI=https://nid.naver.com/oauth2.0/authorize
SAGOPALGO_NAVER_TOKEN_URI=https://nid.naver.com/oauth2.0/token
SAGOPALGO_NAVER_PROFILE_URI=https://openapi.naver.com/v1/nid/me
