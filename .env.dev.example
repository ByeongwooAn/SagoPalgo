# 개발 환경 Docker Compose 설정입니다.
# 실제 실행할 때는 이 파일을 루트의 .env.dev로 복사한 뒤, 아래 값을 본인 PC와 API 발급 정보에 맞게 수정합니다.
# 주의: .env.dev에는 API Key, App Secret, 계좌번호 같은 민감정보가 들어갈 수 있으므로 Git에 커밋하지 않습니다.

# 컨테이너와 서버 로그에서 사용할 기본 시간대입니다.
# 한국에서 개인용 Windows 앱으로 사용할 경우 기본값 Asia/Seoul을 그대로 둡니다.
SAGOPALGO_TIMEZONE=Asia/Seoul

# MySQL 컨테이너가 호스트 PC에 열 포트입니다.
# 이미 로컬 MySQL이 3306을 사용 중이면 3307처럼 다른 포트로 바꿉니다.
SAGOPALGO_MYSQL_PORT=3306

# Docker 개발 DB 이름입니다.
# 처음 컨테이너 볼륨을 만들 때 Back/database/schema.sql이 이 이름의 DB에 테이블을 생성합니다.
SAGOPALGO_MYSQL_DATABASE=sagopalgo_dev

# MySQL root 비밀번호입니다.
# 개발용이라도 기본 placeholder 대신 본인이 기억할 수 있는 값으로 바꿉니다.
SAGOPALGO_MYSQL_ROOT_PASSWORD=change-me-dev-root-password

# Spring Boot API 컨테이너가 호스트 PC에 열 포트입니다.
# Docker 내부 Nginx를 거치지 않고 http://localhost:8080 으로 직접 호출할 때 사용합니다.
SAGOPALGO_API_PORT=8080

# Nginx 리버스 프록시가 호스트 PC에 열 포트입니다.
# README와 수동 테스트 가이드는 기본적으로 http://localhost:8081 경유 호출을 예시로 씁니다.
SAGOPALGO_PROXY_HTTP_PORT=8081

# 로컬 Nginx server_name입니다.
# 개인 PC 개발 환경에서는 localhost를 그대로 둡니다.
SAGOPALGO_NGINX_SERVER_NAME=localhost

# 개인용 Windows 프로그램 모드입니다.
# true이면 JWT/OAuth 로그인 없이 아래 user-id를 현재 로컬 사용자로 사용합니다.
SAGOPALGO_PERSONAL_MODE_ENABLED=true

# 로컬 개인 사용자 ID입니다.
# DB의 users, holdings, watchlist, user_capital 데이터를 이 ID로 묶습니다. 특별한 이유가 없으면 1을 유지합니다.
SAGOPALGO_PERSONAL_MODE_USER_ID=1

# 앱과 API 응답에서 표시할 로컬 사용자 이름입니다.
SAGOPALGO_PERSONAL_MODE_NICKNAME=개인 사용자

# 로컬 사용자 식별용 이메일입니다.
# 실제 로그인 메일이 아니라 DB 호환용 값이므로 기본값을 유지해도 됩니다.
SAGOPALGO_PERSONAL_MODE_EMAIL=local@sagopalgo.local

# Flutter Windows 앱 시작 시 PIN 잠금을 쓰고 싶으면 숫자/문자 PIN을 넣습니다.
# 비워두면 앱 잠금 화면을 표시하지 않습니다. 예: SAGOPALGO_APP_LOCK_PIN=1234
SAGOPALGO_APP_LOCK_PIN=

# KB증권은 계좌 조회와 추후 주문 기능의 기준 증권사입니다.
# 공식 API 문서의 공개 path와 기본 요청값은 백엔드 application.yml 기본값으로 관리합니다.
# 이 파일에는 실행 여부와 내 계정의 비밀값만 둡니다.
# KB 현재가 시세 조회(IVU10140)를 사용하려면 true로 바꿉니다.
SAGOPALGO_KB_MARKET_DATA_ENABLED=false
SAGOPALGO_KB_ACCOUNT_ENABLED=false
SAGOPALGO_KB_ORDER_ENABLED=false

# KB증권 Open API 포털에서 발급받은 App Key입니다.
# 실제 값은 .env.dev에만 넣고 .env.dev.example에는 넣지 않습니다.
SAGOPALGO_KB_APP_KEY=

# KB증권 Open API 포털에서 발급받은 App Secret입니다.
# 절대 Git에 커밋하지 않습니다.
SAGOPALGO_KB_APP_SECRET=

# 선택값입니다. 현재 SSQM1801 보유주식 조회는 계좌번호를 요청값으로 받지 않습니다.
# 값을 넣으면 계좌 목록 API가 없을 때 앱에서 마스킹된 연결 계좌로 표시하는 용도로만 사용합니다.
SAGOPALGO_KB_ACCOUNT_NUMBER=

# 토스증권은 분석용 시세/종목 정보 보조 소스로 둡니다.
# 토스증권 Open API 시세/종목 정보 조회를 붙일 때 true로 바꿉니다.
# 현재 백엔드는 토스 주문을 사용하지 않으며, 소수점 주문 가능 여부 확인용 설계 메모만 남겨둔 상태입니다.
SAGOPALGO_TOSS_MARKET_DATA_ENABLED=false

# 토스증권 Open API에서 발급받은 App Key입니다.
# 토스 연동 구현 전에는 비워둡니다.
SAGOPALGO_TOSS_APP_KEY=

# 토스증권 Open API에서 발급받은 App Secret입니다.
# 실제 값은 .env.dev에만 넣습니다.
SAGOPALGO_TOSS_APP_SECRET=

# 개발용 한국투자증권 Open API 시세 설정입니다.
# 실제 현재가를 확인할 때만 enabled를 true로 바꾸고 App Key/Secret을 입력합니다.
# 현재 구현에서는 KIS를 계좌/주문이 아니라 보유 종목 현재가 조회용으로만 사용합니다.
SAGOPALGO_KIS_ENABLED=false

# 한국투자증권 Open API Base URL입니다.
# 개발/모의투자는 openapivts, 실전은 openapi URL을 사용합니다.
# 모의 REST: https://openapivts.koreainvestment.com:29443
# 실전 REST: https://openapi.koreainvestment.com:9443
SAGOPALGO_KIS_BASE_URL=https://openapivts.koreainvestment.com:29443

# 한국투자증권 개발자센터에서 발급받은 App Key입니다.
# 실제 현재가 조회를 테스트할 때 your-dev-kis-app-key를 실제 값으로 바꿉니다.
SAGOPALGO_KIS_APP_KEY=your-dev-kis-app-key

# 한국투자증권 개발자센터에서 발급받은 App Secret입니다.
# 실제 값은 .env.dev에만 넣고 커밋하지 않습니다.
SAGOPALGO_KIS_APP_SECRET=your-dev-kis-app-secret

# KIS OAuth token 발급 grant type입니다.
# 일반적인 App Key/App Secret 방식은 client_credentials를 그대로 사용합니다.
SAGOPALGO_KIS_GRANT_TYPE=client_credentials

# KIS access token 발급 경로입니다.
# 한국투자증권 문서 기준 기본값은 /oauth2/tokenP 입니다.
SAGOPALGO_KIS_TOKEN_PATH=/oauth2/tokenP

# 국내주식 현재가 조회 API path입니다.
# 현재 MarketPriceService가 보유 종목의 현재가를 조회할 때 사용합니다.
SAGOPALGO_KIS_PRICE_PATH=/uapi/domestic-stock/v1/quotations/inquire-price

# 국내주식 현재가 조회 TR ID입니다.
# 실전/모의 환경이나 API 종류에 따라 문서가 다른 TR ID를 요구하면 문서 기준으로 수정합니다.
SAGOPALGO_KIS_PRICE_TR_ID=FHKST01010100

# 고객 유형 코드입니다.
# 개인 계좌/개인 앱은 보통 P를 사용합니다.
SAGOPALGO_KIS_CUSTOMER_TYPE=P
