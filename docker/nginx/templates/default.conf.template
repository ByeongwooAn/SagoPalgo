# 로컬 개발용 HTTP 리버스 프록시 설정입니다.
# nginx Docker 이미지는 /etc/nginx/templates/*.template 파일의 환경 변수를 치환해 conf.d에 배치합니다.

server {
    listen 80;
    server_name ${SAGOPALGO_NGINX_SERVER_NAME};

    # Spring Boot API로 전달되는 요청 크기 제한입니다.
    # 소셜 로그인과 일반 JSON API에는 충분하고, 향후 이미지 업로드가 생기면 늘릴 수 있습니다.
    client_max_body_size 10m;

    # API 서버 상태를 간단히 확인하기 위한 프록시 레벨 헬스 체크 경로입니다.
    location = /health {
        default_type text/plain;
        return 200 "ok\n";
    }

    # 모든 요청을 내부 Docker 네트워크의 Spring Boot API 서버로 전달합니다.
    location / {
        proxy_pass http://spring-api:8080;
        proxy_http_version 1.1;

        # 원래 요청의 host/protocol/client ip를 Spring Boot가 알 수 있도록 전달합니다.
        # Docker nginx 템플릿은 정의된 환경 변수만 치환하므로,
        # $host 같은 Nginx 런타임 변수는 원래 문법 그대로 유지합니다.
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # API 응답 지연이 길어지는 분석 요청을 고려해 timeout을 기본값보다 넉넉히 둡니다.
        proxy_connect_timeout 10s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
    }
}
