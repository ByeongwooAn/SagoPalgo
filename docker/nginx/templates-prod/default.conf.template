# 개인 PC 고정 실행용 HTTP 리버스 프록시 템플릿입니다.
# 현재 프로젝트는 공개 운영 도메인과 HTTPS 배포를 기본 목표로 두지 않습니다.

server {
    listen 80;
    server_name ${SAGOPALGO_NGINX_SERVER_NAME};

    # 일반 JSON API에는 충분한 크기이며, 이미지 업로드가 들어오면 기준을 늘립니다.
    client_max_body_size 10m;

    # 로컬 실행 확인용 프록시 헬스 체크 경로입니다.
    location = /health {
        default_type text/plain;
        return 200 "ok\n";
    }

    # 모든 API 요청을 Docker 내부 네트워크의 Spring Boot 컨테이너로 전달합니다.
    location / {
        proxy_pass http://spring-api:8080;
        proxy_http_version 1.1;

        # Spring Boot가 원래 요청 도메인과 클라이언트 IP를 알 수 있도록 표준 프록시 헤더를 전달합니다.
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # 외부 시세 API와 AI 분석 호출 지연을 고려해 기본값보다 넉넉하게 둡니다.
        proxy_connect_timeout 10s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
    }
}
