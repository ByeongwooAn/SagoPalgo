# 운영 HTTPS용 Nginx 템플릿입니다.
# Docker nginx 엔트리포인트가 ${SAGOPALGO_*} 환경 변수만 실제 값으로 치환해 /etc/nginx/conf.d/default.conf를 만듭니다.

server {
    listen 80;
    server_name ${SAGOPALGO_NGINX_SERVER_NAME};

    # 운영에서는 암호화되지 않은 HTTP 요청을 모두 HTTPS로 강제 전환합니다.
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name ${SAGOPALGO_NGINX_SERVER_NAME};

    # 인증서는 컨테이너 내부의 /etc/nginx/certs 아래로 마운트된 파일을 참조합니다.
    # 실제 호스트 경로는 .env.prod의 SAGOPALGO_NGINX_CERTS_DIR에서 관리합니다.
    ssl_certificate ${SAGOPALGO_NGINX_SSL_CERTIFICATE_PATH};
    ssl_certificate_key ${SAGOPALGO_NGINX_SSL_CERTIFICATE_KEY_PATH};

    # 오래된 TLS 버전을 끄고 모바일 앱과 최신 브라우저에서 안전하게 쓸 수 있는 버전만 허용합니다.
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;

    # 소셜 로그인과 일반 JSON API에는 충분한 크기이며, 이미지 업로드가 들어오면 운영 기준으로 늘릴 수 있습니다.
    client_max_body_size 10m;

    # 로드밸런서, 배포 후 확인, 모니터링에서 사용할 수 있는 간단한 프록시 헬스 체크 경로입니다.
    location = /health {
        default_type text/plain;
        return 200 "ok\n";
    }

    # 모든 API 요청을 Docker 내부 네트워크의 Spring Boot 컨테이너로 전달합니다.
    location / {
        proxy_pass http://spring-api:8080;
        proxy_http_version 1.1;

        # Spring Boot가 원래 요청 도메인, 클라이언트 IP, HTTPS 여부를 알 수 있도록 표준 프록시 헤더를 전달합니다.
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;

        # 모바일 네트워크 지연이나 외부 OAuth 검증 지연을 고려해 기본값보다 넉넉하게 둡니다.
        proxy_connect_timeout 10s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
    }
}
